# Copy to .env.local (real/dev deployment) or .env.test.local (local
# `npx supabase start` test runs, see vitest.config.ts) and fill in real
# values there. This file documents every required var; it is committed
# on purpose (see the "!.env.example" exception in .gitignore) and must
# never contain a live secret -- only variable names and non-secret
# example/default values.

# Supabase project URL. Read by src/lib/supabase/{server,client}.ts (the
# only files allowed to import a Supabase client, per
# ARCHITECTURE-SPINE.md AD-1/AD-2). Example below is the fixed local
# `npx supabase start` URL for this repo -- never point this at a real
# project from a shared/CI environment.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (public) key, paired with the URL above. Example below is
# the Supabase CLI's universal local-dev default anon key -- this repo's
# supabase/config.toml sets no custom auth.jwt_secret, so it's not tied to
# this repo's project id specifically, just the CLI's generic demo
# default. Not a secret, but still not valid against any real project. For
# a real deployment, use that project's own anon key from the Supabase
# dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# HMAC signing secret for the first-party app token (Story 1.4, see
# src/server/shared/auth.ts), issued alongside -- never replacing -- the
# Supabase session cookie at login (ARCHITECTURE-SPINE.md AD-5). Required;
# there is no default. Generate a fresh one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same value across local/test/staging/production.
APP_TOKEN_SECRET=

# Anthropic API key (server-only), read by src/server/managers/
# aiInterpretationManager.ts to generate the AI profile/report-group
# interpretations (Story 6.4/7.3). Optional -- without it, every
# interpretation call resolves `null` and the interpretation block simply
# doesn't render; nothing throws or breaks. Get one from
# https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Resend API key (server-only), read by src/server/infra/email.ts (AD-12)
# to send real invitation/thank-you emails (Story 7.6). Optional -- without
# it, every send is a silent no-op (same graceful-degradation contract as
# ANTHROPIC_API_KEY above). Needs a Resend account with a verified sending
# domain for real deliverability -- https://resend.com.
RESEND_API_KEY=

# Base URL this deployment is reachable at, used only to build absolute
# links inside outgoing emails (src/server/infra/email.ts's getSiteUrl()
# -- a relative path can't be used in an email, unlike in-app navigation).
# Optional in a Vercel deployment: falls back to Vercel's own
# auto-populated VERCEL_URL, then to http://localhost:3000 for local dev.
# Only set this explicitly for a custom domain (Vercel's own
# *.vercel.app preview/prod URL doesn't need it) or a non-Vercel host.
NEXT_PUBLIC_SITE_URL=

# USE_NEW_API_ADMIN_MEMBERS was the per-domain rollback-safety flag for the
# admin/members/auth domain migration (Story 3.4/3.5). Removed by Story
# 5.1b (spec-5-1b-delete-old-path-admin-reports.md) once the old
# direct-Supabase path it gated was deleted -- src/app/actions/
# {admin,members,auth}.ts and src/app/dashboard/page.tsx now delegate to
# their managers unconditionally.

# USE_NEW_API_CYCLES was the per-domain rollback-safety flag for the cycles
# (feedback-cycle lifecycle) domain migration (Story 3.10/3.11). Removed by
# Story 5.1a (spec-5-1a-delete-old-path-cycles.md) once the old
# direct-Supabase path it gated was deleted -- src/app/actions/cycles.ts's
# 6 Server Actions now delegate to @/server/managers/cyclesManager
# unconditionally.

# USE_NEW_API_FEEDBACK was the per-domain rollback-safety flag for the
# ad-hoc feedback domain migration (Story 3.16/3.17). Removed by Story 5.1c
# (spec-5-1c-delete-old-path-feedback-responder.md) once the old
# direct-Supabase path it gated was deleted -- src/app/actions/feedback.ts's
# 5 flagged Server Actions now delegate to @/server/managers/feedbackManager
# unconditionally.

# USE_NEW_API_RESPONDER was the per-domain rollback-safety flag for the
# responder/invitation domain migration (Story 3.22/3.23). Removed by Story
# 5.1c (spec-5-1c-delete-old-path-feedback-responder.md) once the old
# direct-Supabase path it gated was deleted -- submitFeedbackResponse in
# src/app/actions/feedback.ts and the Server Components
# src/app/responder/[token]/page.tsx and src/app/invitacion/[token]/page.tsx
# now delegate to @/server/managers/responderManager unconditionally.

# USE_NEW_API_REPORTS was the per-domain rollback-safety flag for the
# read-only reports domain migration (Story 3.28/3.29). Removed by Story
# 5.1b (spec-5-1b-delete-old-path-admin-reports.md) once the old
# direct-Supabase path it gated was deleted -- src/app/dashboard/page.tsx,
# src/app/dashboard/mi-mapa/page.tsx, and src/app/dashboard/
# informe-empresa/page.tsx now delegate to their managers unconditionally.
