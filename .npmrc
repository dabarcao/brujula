# vitest ^5.0 (see package.json) peer-requires @types/node ^22 || >=24, but
# this repo pins @types/node ^20 (a Next.js peer) -- a real, pre-existing
# conflict, not something to "fix" by bumping @types/node out from under
# Next.js. Recorded here so a plain `npm install`/`npm ci` doesn't fail.
legacy-peer-deps=true
