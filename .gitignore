# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# informes reales de personas identificables (perfiles TLC a migrar) —
# nunca deben subirse al repo
/migrables

# clon local del repo reingenierizado (brujula-app-mvc), para poder
# arrancarlo con preview_start desde dentro de este project root — no es
# parte de este repo, nunca debe subirse aquí
/mvc-review

# typescript
*.tsbuildinfo
next-env.d.ts
